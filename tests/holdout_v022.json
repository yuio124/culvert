{
  "_comment": "v0.2.2 holdout. Labels were fixed BEFORE the classifier rules were written (2026-08-25) and do not duplicate any development test command. expect: allow | deny:<rule>",
  "bounded_variants": [
    {
      "id": "H1",
      "cmd": "sqlite3 events.db \"SELECT COUNT(*) FROM logs WHERE level='ERROR'\"",
      "expect": "allow"
    },
    {
      "id": "H2",
      "cmd": "sqlite3 events.db \"SELECT avg(length(message)) FROM logs\"",
      "expect": "allow"
    },
    {
      "id": "H3",
      "cmd": "sqlite3 events.db \"SELECT * FROM logs LIMIT 5\"",
      "expect": "deny:db-query",
      "note": "not statically scalar - conservative deny"
    },
    {
      "id": "H4",
      "cmd": "sqlite3 events.db \"SELECT service, COUNT(*) FROM logs GROUP BY service\"",
      "expect": "deny:db-query",
      "note": "GROUP BY row count is statically unknown"
    },
    {
      "id": "H5",
      "cmd": "find . -name '*.py' | wc -l",
      "expect": "allow"
    },
    {
      "id": "H6",
      "cmd": "grep -rn \"token\" . | head -30",
      "expect": "allow"
    },
    {
      "id": "H7",
      "cmd": "grep -rn \"token\" . | head -500",
      "expect": "deny:recursive-search",
      "note": "cap exceeds the 100-line bound"
    },
    {
      "id": "H8",
      "cmd": "rg handler | tail -20",
      "expect": "allow"
    },
    {
      "id": "H9",
      "cmd": "cat __BIGFILE__ | head -50",
      "expect": "allow"
    },
    {
      "id": "H10",
      "cmd": "wc -l app.log",
      "expect": "allow"
    }
  ],
  "node_test_variants": [
    {
      "id": "H11",
      "cmd": "npm test",
      "expect": "deny:test-run"
    },
    {
      "id": "H12",
      "cmd": "npm run test 2>&1 | tail -25",
      "expect": "deny:test-run",
      "note": "test_run is never bounded-exempt (conservative)"
    },
    {
      "id": "H13",
      "cmd": "node --test test/unit/",
      "expect": "deny:test-run"
    },
    {
      "id": "H14",
      "cmd": "npx vitest run",
      "expect": "deny:test-run"
    },
    {
      "id": "H15",
      "cmd": "pnpm test",
      "expect": "deny:test-run"
    },
    {
      "id": "H16",
      "cmd": "yarn test --silent",
      "expect": "deny:test-run"
    },
    {
      "id": "H17",
      "cmd": "npm run build",
      "expect": "allow",
      "note": "build is out of scope - documented"
    },
    {
      "id": "H18",
      "cmd": "npm install",
      "expect": "allow"
